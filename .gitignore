# Python
__pycache__/
*.pyc
.pytest_cache/

# Eval runtime artifacts (regenerated by tools/eval)
behavior-spec/.eval-cache/
behavior-spec/eval-report.json

# Node runtime data (per-run, not part of Alma's committed identity)
node/data/

# Private signing keys and secrets (never publish these).
# Public keys (*.pub) stay committed so signatures verify.
keys/*.key
keys/*private*
tests/keys/*.key
config/*.secret.json
.env
state/status.json
state/daemon.log
state/daemon.out
state/daemon.err
