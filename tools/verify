#!/usr/bin/env python3
"""tools/verify -- walk the ledger from genesis to head and verify the StateRoot.

Checks every event's canonical form, hash chain, and 2-of-3 maintainer
signatures (CLAUDE.md §2.3), then verifies the signed StateRoot binds the
constitution and the verified ledger head. Any single-byte change anywhere in
history makes this fail.

Usage:
  tools/verify [--root DIR] [--ledger DIR] [--no-state] [--quiet]

Exit code 0 if everything verifies, 1 otherwise.
"""

import argparse
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, ROOT)

from almalib import ledger as L, state as S, policy  # noqa: E402


def main(argv=None):
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default=ROOT, help="repo root (default: repo containing this tool)")
    ap.add_argument("--ledger", default=None, help="ledger dir (default: <root>/ledger)")
    ap.add_argument("--no-state", action="store_true", help="skip StateRoot verification")
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args(argv)

    ledger_dir = args.ledger or os.path.join(args.root, "ledger")

    v = L.verify_chain(ledger_dir, args.root)
    req = policy.threshold(args.root)
    if not args.quiet:
        if v.ok:
            print("ledger INTACT: %d events, head=%s" % (v.count, v.head_hash[:16]))
            print("  unaltered since genesis; this does NOT establish that its "
                  "contents are true")
            if req == 0:
                print("  authorization: NONE -- state/config.json threshold is 0, "
                      "so no signature was required")
            else:
                print("  authorization: %d valid signature(s) required per event" % req)
        else:
            print("ledger FAILED: %s" % (v.errors[0] if v.errors else "unknown"))
    ok = v.ok

    if not args.no_state:
        sr_ok, sr_errs = S.verify_state_root(args.root, ledger_dir)
        if not args.quiet:
            if sr_ok:
                print("StateRoot OK: binds constitution.md and the current ledger head"
                      + ("" if req == 0 else "; %d signature(s) verified" % req))
            else:
                for e in sr_errs:
                    print("StateRoot FAILED: %s" % e)
        ok = ok and sr_ok

    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
