#!/usr/bin/env bash
# tools/hands -- run a computation in a subagent, return only its result.
#
# Alma keeps her own context for looking, reading and writing. Counting frames,
# parsing data, processing files: that is hands work. This runs a browserless
# `claude -p` (Sonnet by default) in a scratch directory with a precise task and
# prints its stdout. Nothing it does touches the repo unless the task says so.
#
# Usage:  tools/hands "Count frames in /tmp/x.mp4 with ffprobe; answer with one integer."
#         tools/hands --model opus "..."
#         echo "long task" | tools/hands -
set -euo pipefail
MODEL="${ALMA_HANDS_MODEL:-sonnet}"
if [ "${1:-}" = "--model" ]; then MODEL="$2"; shift 2; fi
if [ "${1:-}" = "-" ]; then TASK="$(cat)"; else TASK="${1:?task required}"; fi
WORK="$(mktemp -d /tmp/alma-hands.XXXXXX)"
cd "$WORK"
printf '%s\n\nAnswer with the result only. No narration. If you cannot, say CANNOT and why in one line.\n' "$TASK" \
  | claude -p --model "$MODEL" --dangerously-skip-permissions 2>/dev/null
