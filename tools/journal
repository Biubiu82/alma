#!/usr/bin/env python3
"""tools/journal -- append a journal entry heading, stamped from the clock.

Alma writes her journal by hand. On 2026-09-11 she discovered she had headed
roughly twenty entries with times she had invented -- she assumed each cycle
took the half hour her instructions describe and stamped accordingly, and then
wrote inside the fiction ("nine hours in", "dawn is coming in about forty
minutes"). The session had been seventy minutes. Every timestamp in her ledger
was correct over the same period, because tools/append calls the clock and she
does not get a vote.

This tool gives the journal the same discipline.

  * The date and the time come from the system clock. There is deliberately no
    flag to supply them; passing one is an error rather than an override.
  * A new journal file opens with its timezone declared on line 1, so a reader
    can reconcile it against the ledger (which stamps UTC) without guessing.
  * It writes only under <root>/journal/. It never touches ledger/ or
    behavior-spec/ (CLAUDE.md 2.2a).

Usage:
  tools/journal --title "where I went and why"
  tools/journal --title "..." --body @entry.md
  tools/journal --title "..." --body -          # read the body from stdin
  tools/journal --guidance --body @g.md         # writes a "## Guidance HH:MM"

Prints the path written and the heading it appended.
"""

import argparse
import os
import sys
from datetime import datetime

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# Arguments that would let a caller state a time instead of reading one. They
# are refused by name so the refusal is explicit rather than an accident of
# argparse, and so a test can assert it.
FORBIDDEN = ("--time", "--date", "--timestamp", "--now", "--at")


def local_now():
    """The clock, and the local zone's offset. Read, never supplied."""
    return datetime.now().astimezone()


def tz_header(now):
    off = now.strftime("%z")  # e.g. +0700
    pretty = "UTC%s%s" % (off[0], off[1:3].lstrip("0") or "0")
    if off[3:5] != "00":
        pretty += ":" + off[3:5]
    return "# %s (times are local, %s)" % (now.strftime("%Y-%m-%d"), pretty)


def read_body(spec):
    if spec is None:
        return ""
    if spec == "-":
        return sys.stdin.read()
    if spec.startswith("@"):
        with open(spec[1:], encoding="utf-8") as f:
            return f.read()
    return spec


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    for bad in FORBIDDEN:
        if any(a == bad or a.startswith(bad + "=") for a in argv):
            sys.stderr.write(
                "tools/journal: %s is not accepted. The time is read from the "
                "clock, never supplied -- that is the whole point of this tool.\n" % bad)
            return 2

    ap = argparse.ArgumentParser(prog="journal")
    ap.add_argument("--root", default=ROOT)
    ap.add_argument("--title", help="short heading, e.g. 'the well, and the empty skull'")
    ap.add_argument("--guidance", action="store_true",
                    help="write a '## Guidance HH:MM' heading instead of a titled entry")
    ap.add_argument("--body", help="entry text, @file, or - for stdin")
    ap.add_argument("--quiet", action="store_true")
    args = ap.parse_args(argv)

    if not args.guidance and not args.title:
        ap.error("need --title (or --guidance)")

    now = local_now()
    date = now.strftime("%Y-%m-%d")
    hhmm = now.strftime("%H:%M")

    jdir = os.path.join(args.root, "journal")
    os.makedirs(jdir, exist_ok=True)
    path = os.path.join(jdir, "%s.md" % date)

    fresh = not os.path.exists(path) or os.path.getsize(path) == 0
    heading = ("## Guidance %s" % hhmm) if args.guidance \
        else ("## %s — %s" % (hhmm, args.title))

    body = read_body(args.body).rstrip("\n")

    with open(path, "a", encoding="utf-8") as f:
        if fresh:
            f.write(tz_header(now) + "\n")
        f.write("\n" + heading + "\n")
        if body:
            f.write("\n" + body + "\n")

    if not args.quiet:
        print("%s\n%s" % (path, heading))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
